desc:DSH Build Filter
// Low-pass whose cutoff follows the arrangement, driven by beat_position.
// Used to make the intro dull and the drops open without any project
// automation lanes. Bar positions match the 171-bar arrangement:
//   0-15 intro | 16-47 drop A | 48-63 break | 64-95 drop B
//   96-111 jazz | 112-127 vocal | 128-159 drop C | 160-170 outro

slider1:1<0,1,1{Off,On}>Follow arrangement
slider2:18000<20,20000,1>Manual cutoff (Hz)
slider3:0.7<0.1,4,0.01>Resonance

@init
xl1 = 0; xl2 = 0; yl1 = 0; yl2 = 0;
xr1 = 0; xr2 = 0; yr1 = 0; yr2 = 0;
lastCut = -1;

@slider
dirty = 1;

@block
bar = beat_position * 0.25;
cut = slider2;

slider1 > 0.5 ? (
  // piecewise linear breakpoints: [bar, cutoff]
  bar < 16 ? (
    cut = 500 + (6000 - 500) * (bar / 16);
  ) : bar < 48 ? (
    cut = 18000;
  ) : bar < 64 ? (
    // break: dark, then open over the last four bars into drop B
    cut = bar < 60 ? 2200 : 2200 + (16000 - 2200) * ((bar - 60) / 4);
  ) : bar < 96 ? (
    cut = 18000;
  ) : bar < 112 ? (
    cut = 9000;
  ) : bar < 128 ? (
    cut = 3200;
  ) : bar < 160 ? (
    cut = 18000;
  ) : (
    cut = 18000 - (18000 - 900) * ((bar - 160) / 11);
  );
);

cut < 20 ? cut = 20;
cut > 20000 ? cut = 20000;

cut != lastCut ? (
  lastCut = cut;
  w0 = 2 * 3.141592653589793 * cut / srate;
  w0 > 3.0 ? w0 = 3.0;
  cw = cos(w0);
  sw = sin(w0);
  alpha = sw / (2 * slider3);
  b0 = (1 - cw) / 2;
  b1 = 1 - cw;
  b2 = (1 - cw) / 2;
  a0 = 1 + alpha;
  a1 = -2 * cw;
  a2 = 1 - alpha;
  b0 /= a0; b1 /= a0; b2 /= a0; a1 /= a0; a2 /= a0;
);

@sample
x = spl0;
y = b0 * x + b1 * xl1 + b2 * xl2 - a1 * yl1 - a2 * yl2;
xl2 = xl1; xl1 = x; yl2 = yl1; yl1 = y;
spl0 = y;

x = spl1;
y = b0 * x + b1 * xr1 + b2 * xr2 - a1 * yr1 - a2 * yr2;
xr2 = xr1; xr1 = x; yr2 = yr1; yr1 = y;
spl1 = y;
